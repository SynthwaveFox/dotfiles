# mako notifications — orange rice
sort=-time
layer=overlay
anchor=top-right
font=JetBrainsMono Nerd Font 11
width=360
height=140
# Blur covers the whole popup surface, so the gap goes outside it (outer-margin)
# and the corners are clipped by niri (geometry-corner-radius = border-radius).
outer-margin=12
margin=0
padding=14
border-size=2
border-radius=10
icons=1
max-icon-size=48
default-timeout=5000
ignore-timeout=1

background-color=#181825cc
text-color=#cdd6f4
border-color=#ff8a00
progress-color=over #ff8a00

[urgency=low]
border-color=#4d443b
default-timeout=3000
[urgency=normal]
border-color=#ff8a00
default-timeout=10000

[urgency=high]
border-color=#f38ba8
default-timeout=0

# Toggled from the bar bell (waybar/scripts/dnd.sh)
[mode=do-not-disturb]
invisible=1
