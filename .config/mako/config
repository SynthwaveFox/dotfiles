# mako notifications — orange rice
sort=-time
layer=overlay
anchor=top-right
font=JetBrainsMono Nerd Font 11
width=360
height=140
margin=12
padding=14
border-size=2
border-radius=10
icons=1
max-icon-size=48
default-timeout=5000
ignore-timeout=1

background-color=#181825
text-color=#cdd6f4
border-color=#ff8a00
progress-color=over #ff8a00

[urgency=low]
border-color=#4d443b
default-timeout=3000
[urgency=normal]
border-color=#ff8a00
default-timeout=10000

[urgency=high]
border-color=#f38ba8
default-timeout=0
