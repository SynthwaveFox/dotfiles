// Same bar on every monitor (bar.jsonc), sized per screen:
// the 31.5" AOC and the small 15.6" KYY get bigger text, the Dell keeps the laptop size
[
  {
    "include": ["~/.config/waybar/bar.jsonc"],
    "output": "DP-3",
    "name": "primary",
    "height": 48
  },
  {
    "include": ["~/.config/waybar/bar.jsonc"],
    "output": "DP-2",
    "name": "kyy",
    "height": 52
  },
  {
    "include": ["~/.config/waybar/bar.jsonc"],
    "output": "HDMI-A-1"
  }
]
