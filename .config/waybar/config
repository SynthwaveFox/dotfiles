// Laptop bar: the exodus Outrun strip (bar.jsonc) on the single eDP-1 screen,
// plus the laptop-only modules (backlight, battery, temp, fan).
// Wi-Fi lives in the tray (nm-applet).
{
  "include": ["~/.config/waybar/bar.jsonc"],
  "height": 40,

  "modules-left": [
    "custom/arch",
    "niri/workspaces",
    "temperature",
    "custom/fan",
    "mpris"
  ],
  "modules-right": [
    "tray",
    "custom/dnd",
    "cpu",
    "memory",
    "backlight",
    "wireplumber",
    "wireplumber#source",
    "battery"
  ],

  // narrower now-playing so it doesn't run into the clock on the 1504px-wide screen
  "mpris": {
    "format": "<span color='#ff8a00' size='larger'>{status_icon}</span>  {title} <span color='#7f849c'>·</span> {artist}",
    "format-paused": "<span color='#7f849c' size='larger'>{status_icon}</span>  {title} <span color='#7f849c'>·</span> {artist}",
    "format-stopped": "",
    "status-icons": { "playing": "󰎆", "paused": "󰏤" },
    "title-len": 18,
    "artist-len": 12,
    "tooltip-format": "{player}: {title}\n{artist} — {album}\nClick: play/pause · Scroll: skip",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  "temperature": {
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "interval": 5,
    "critical-threshold": 85,
    "format": "<span color='#ff8a00' size='larger'></span>  {temperatureC}°",
    "format-critical": "<span color='#f38ba8' size='larger'></span>  {temperatureC}°",
    "tooltip-format": "CPU package: {temperatureC}°C"
  },
  "custom/fan": {
    "exec": "~/.config/waybar/scripts/fan.sh",
    "return-type": "json",
    "interval": 5,
    "format": "<span color='#ff8a00' size='larger'>󰈐</span>  {}"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "<span color='#ff8a00' size='larger'>{icon}</span>  {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "brightnessctl set 1%+",
    "on-scroll-down": "brightnessctl set 1%-"
  },
  "battery": {
    "interval": 5,
    "states": { "warning": 30, "critical": 15 },
    "format": "<span color='#ff8a00' size='larger'>{icon}</span>  {capacity}%",
    // icon takes the state colour so it stays readable (amber / pink) off the charger
    "format-warning": "<span color='#ffb347' size='larger'>{icon}</span>  {capacity}%",
    "format-critical": "<span color='#f38ba8' size='larger'>{icon}</span>  {capacity}%",
    "format-charging": "<span color='#a6e3a1' size='larger'>󰂄</span>  {capacity}%",
    "format-plugged": "<span color='#a6e3a1' size='larger'>󰂄</span>  {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}\n{power:0.1f} W"
  },
  // the bar.jsonc min-lengths are sized for the wide desktop screens
  "cpu": {
    "interval": 3,
    "format": "<span color='#ff8a00' size='x-large' rise='-1pt'></span>  {usage}%",
    "on-click": "ghostty -e btop"
  },
  "memory": {
    "interval": 5,
    "format": "<span color='#ff8a00' size='x-large' rise='-1pt'></span>  {used:0.1f}G",
    "tooltip-format": "RAM {used:0.1f} / {total:0.1f} GB ({percentage}%)\nSwap {swapUsed:0.1f} / {swapTotal:0.1f} GB"
  }
}
