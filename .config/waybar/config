{
  "layer": "top",
  "position": "top",
  "height": 40,
  "modules-left": [
    "niri/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
     "network",
     "memory",
     "cpu",
     "backlight",
     "wireplumber",
     "wireplumber#source",
     "battery",
     "custom/exit"
  ],
  "custom/launcher": {
    "format": "<span color='#F38BA8'></span>",
    // "on-click": "wofi --show drun --insensitive --allow-images"
    "on-click": "pkill rofi || rofi -show drun --insensitive --allow-images"
  },
  "niri/workspaces": {
    "format": "{index}",
    "format-icons": {
       "default": "",
       "active": ""
    }
  },
  /*"inhibitor": {
    "on-click": "",
    "what": "idle",
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "custom/caffeine": {
    "on-click": "",
    "exec": "~/.config/waybar/scripts/caffeine.sh",
    "return-type": "json",
    "interval": 3,
    "format-icons": [
      "﯈",
      ""
    ],
    "format": "{icon}"
  },
  "custom/updates": {
    "exec": "(checkupdates ; paru -Qua) | wc -l",
    "interval": 12000,
    "format": " {}",
    "on-click": "wezterm start yay -Syu --noconfirm --devel"
  },*/
  "tray": {
    "on-click": "",
    "icon-size": 17,
    "spacing": 10
  },
  "backlight": {
    "on-click": "",
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "on-scroll-up": "brightnessctl set 1%+",
    "on-scroll-down": "brightnessctl set 1%-",
    "min-length": 6
  },
  "battery": {
    "interval": 5,
    "states": {
      "good": 80,
      "warning": 30,
      "critical": 20
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": [
      "critical 󰂎",
      "low 󰁺",
      "󰁻",
      "󰁼",
      "󰁾",
      "󰁿",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },
  "clock": {
    "on-click": "",
    "format": " {:%H:%M  %m/%d}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "network": {
    "interval": 5,
    "format-wifi": "󰖩  {essid}",
    "format-ethernet": "󰈀 ",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "󰖪 Disc.",
    "tooltip-format-wifi": "Signal Strength: {signalStrength}% | Down Speed: {bandwidthDownBits}, Up Speed: {bandwidthUpBits}",
    "tooltip-format-ethernet": "Down Speed: {bandwidthDownBits}, Up Speed: {bandwidthUpBits}",
    // "on-click": "wofi-wifi-menu",
    "on-click": "hyprctl dispatch exec [workspace special:scratchpad] \"ghostty -e \"iwctl\"\""
  },
  "cpu": {
    "on-click": "",
    "interval": 5,
    "format": " {usage}%"
    // "max-length": 10
  },
  "memory": {
    "on-click": "",
    "interval": 5,
    "format": " {used:0.1f}G/{total:0.1f}G"
    // "max-length": 30
  },
  "wireplumber": {
    "format": " {volume}%",
    "format-muted": "󰖁 Muted",
    // "format-source": " {source_volume}",
    "on-click": "",
    "scroll-step": 1
  },
  "wireplumber#source": {
      "node-type": "Audio/Source",
      "format": " {volume}%",
      "format-muted": "  Muted",
      "on-click": "wpctl set-volume @DEFAULT_SOURCE@ 1"
  },
  "custom/spotify": {
    "exec": "$HOME/.config/waybar/scripts/spotify.sh",
    "max-length": 33,
    "format": " {}",
    "on-click": "playerctl play-pause",
    "on-double-click": "playerctl next",
    "on-right-click": "python /home/rishabh/.config/hypr/scripts/empris.py"
  },
  "custom/exit": {
    "format": "<span color='#F38BA8'>⏻</span>",
    "on-click": "systemctl shutdown now"
  }
}
