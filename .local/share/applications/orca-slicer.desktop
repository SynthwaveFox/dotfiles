[Desktop Entry]
# Local override: always use the Zink renderer OrcaSlicer needs on NVIDIA 555+.
# Its own detection runs glxinfo, which fails when launched without DISPLAY (fuzzel).
# GTK_THEME=Adwaita: Orca paints its own (dark) colours but forces white text boxes, so a
# dark GTK theme left light text on white. Light Adwaita ignores ~/.config/gtk-3.0/gtk.css colours.
Name=OrcaSlicer
Exec=env GTK_THEME=Adwaita ZINK_DISABLE_OVERRIDE=1 WEBKIT_DISABLE_DMABUF_RENDERER=1 /opt/orca-slicer/AppRun %U
Icon=OrcaSlicer
Type=Application
PrefersNonDefaultGPU=true
X-KDE-RunOnDiscreteGpu=true
Categories=Utility;
MimeType=model/stl;application/vnd.ms-3mfdocument;application/prs.wavefront-obj;application/x-amf;x-scheme-handler/orcaslicer;x-scheme-handler/bambustudio;
